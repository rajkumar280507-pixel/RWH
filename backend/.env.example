ENVIRONMENT=development
DEBUG=true

# Local dev: set DATABASE_URL directly.
DATABASE_URL=mysql+pymysql://rwh:rwh_app_pw@localhost:3306/rwh

# Railway: if you'd rather not wire a DATABASE_URL variable reference to the
# MySQL plugin, the app will build the connection URL itself from these
# instead (Railway sets them automatically on any service linked to a MySQL
# plugin) — leave DATABASE_URL unset in that case.
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720



RWH_ADMIN_USERNAME=admin
RWH_ADMIN_PASSWORD=change-me

CGWB_GROUNDWATER_URL=https://nwdp.nwic.gov.in/api/3/action/datastore_search
CGWB_GROUNDWATER_RESOURCE_ID=6857c02f-c77e-4576-b349-3e45aacc1c21
CGWB_RAINFALL_URL=https://nwdp.nwic.gov.in/api/3/action/datastore_search
CGWB_RAINFALL_RESOURCE_ID=21b02519-f3d3-409d-a091-94332d848a8e

SYNC_PAGE_SIZE=1000
SYNC_INTERVAL_MINUTES=60
SYNC_MAX_RETRIES=3
SYNC_RETRY_BACKOFF_SECONDS=30
SYNC_HTTP_TIMEOUT_SECONDS=30
